{
  "name": "@saku/env",
  "version": "0.1.0",
  "private": true,
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./remote": {
      "types": "./src/remote.ts",
      "import": "./src/remote.ts"
    },
    "./entry": {
      "types": "./src/entry.ts",
      "import": "./src/entry.ts"
    },
    "./entry-bundle": {
      "default": "./dist/entry.bundle.js"
    }
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.bundle.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@effect/platform-node": "rc",
    "@saku/wire": "workspace:*",
    "effect": "rc",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "tsdown": "^0.22.12",
    "typescript": "^5.9.0",
    "vitest": "^4.1.9"
  }
}
